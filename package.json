{
  "name": "dbt-nav",
  "displayName": "dbt-nav",
  "description": "Hover over a dbt ref() to see the model's full upstream lineage and its direct downstream children.",
  "version": "0.1.0",
  "publisher": "aaaloui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AAAloui/dbt-nav.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "dbt",
    "lineage",
    "sql",
    "data",
    "analytics engineering"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml",
    "onLanguage:sql",
    "onLanguage:jinja-sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbtNav.refresh",
        "title": "dbt-nav: Refresh Lineage"
      }
    ],
    "configuration": {
      "title": "dbt-nav",
      "properties": {
        "dbtNav.lineageSource": {
          "type": "string",
          "enum": ["auto", "manifest", "scan"],
          "enumDescriptions": [
            "Use target/manifest.json when it exists, otherwise scan the project's SQL files.",
            "Only use the compiled manifest.json.",
            "Always scan the project's files for ref() and source() calls (no dbt compile needed)."
          ],
          "default": "auto",
          "description": "Where dbt-nav reads lineage from."
        },
        "dbtNav.manifestPath": {
          "type": "string",
          "default": "target/manifest.json",
          "description": "Path to manifest.json, relative to each dbt project root."
        },
        "dbtNav.upstream.maxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum number of upstream levels to display. 0 means unlimited (all ancestors)."
        },
        "dbtNav.upstream.maxNodes": {
          "type": "number",
          "default": 150,
          "minimum": 1,
          "description": "Maximum number of upstream entries rendered in a hover, to keep huge DAGs readable."
        },
        "dbtNav.downstream.includeTests": {
          "type": "boolean",
          "default": false,
          "description": "Include data tests and unit tests in the downstream list."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/",
    "package": "vsce package"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.9.0"
  }
}
